{
  "framework": "nextjs",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://spiral-wealth-mega-landing-luu9xs.v2.appdeploy.ai/:path*"
    }
  ]
}
