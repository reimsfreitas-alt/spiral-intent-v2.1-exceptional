# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_...
# Dedicated restricted/read-only credential configured in Stripe
STRIPE_READ_ONLY_KEY=rk_test_...

# Ed25519 DER-encoded keys as hex
ED25519_PRIVATE_KEY_HEX=...
ED25519_PUBLIC_KEY_HEX=...

# JSON registry of trusted public keys. RETIRED keys remain valid for historical receipts;
# REVOKED keys are rejected by default.
KEY_REGISTRY_JSON=[]
